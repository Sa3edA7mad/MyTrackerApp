<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Parent is the dark Material theme, not .Light. — with the light parent the
        launch window flashes white before Compose draws the near-black canvas.
    -->
    <style name="Theme.MyTrackerApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B0D0C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
