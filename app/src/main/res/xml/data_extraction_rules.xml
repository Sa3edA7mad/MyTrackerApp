<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer contents for API 31+ (android:dataExtractionRules).

    Both paths are configured: cloud-backup covers "restored onto a new phone from the
    cloud", device-transfer covers "moved directly during phone setup". Leaving
    device-transfer out would mean a direct migration silently arrives with no history.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tracker.db" />
        <include domain="database" path="tracker.db-wal" />
        <include domain="database" path="tracker.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tracker.db" />
        <include domain="database" path="tracker.db-wal" />
        <include domain="database" path="tracker.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
